datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "rhel-openssl-1.0.x", "rhel-openssl-1.1.x", "rhel-openssl-3.0.x", "linux-musl", "linux-musl-openssl-3.0.x"]
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  avatar        String?
  role          String         @default("USER") // "USER" | "VIP" | "ADMIN"
  status        String         @default("active") // "active" | "banned"
  credits       Int            @default(10)
  conversations Conversation[]
  projects      Project[]
  posts         Post[]
  comments      Comment[]
  reactions     PostReaction[]
  orders        PaymentOrder[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Project {
  id            String         @id @default(cuid())
  userId        String
  name          String
  description   String?
  systemPrompt  String?
  icon          String         @default("📁")
  color         String         @default("indigo")
  conversations Conversation[]
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Bot {
  id            String         @id
  name          String
  avatar        String
  description   String?
  systemPrompt  String
  conversations Conversation[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  botId     String
  projectId String?
  title     String?   @default("Cuộc trò chuyện mới")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bot       Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  sender         String       // "USER" | "ASSISTANT"
  content        String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
}

model Post {
  id            String    @id @default(cuid())
  authorId      String
  author        User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title         String
  content       String
  category      String    @default("prompt") // "prompt" | "art" | "code" | "assistant" | "general"
  categoryLabel String    @default("Prompt AI")
  image         String?
  likes         Int       @default(0)
  commentsCount Int       @default(0)
  status        String         @default("published") // "published" | "hidden"
  comments      Comment[]
  reactions     PostReaction[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PostReaction {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   @default("like") // "like" (👍), "love" (❤️), "fire" (🔥), "haha" (😄), "insight" (💡)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model PaymentOrder {
  id                  String    @id @default(cuid())
  orderCode           Int       @unique
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount              Int       // Giá tiền VNĐ
  credits             Int       // Số credits cộng
  packageName         String?
  status              String    @default("PENDING") // "PENDING" | "PAID" | "CANCELLED"
  paymentMethod       String    @default("payos_vietqr")
  payosPaymentLinkId  String?
  transactionId       String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}
